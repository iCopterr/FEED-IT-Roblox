if not game:GetService("RunService"):IsStudio() then return end
local testing=game:GetService("StudioTestService")
if testing:GetTestArgs()~="TutorialVerification" then return end
local checks={}
local ok,failure=xpcall(function()
	local function check(value,label) assert(value,label);table.insert(checks,label) end
	local function waitFor(fn)
		local deadline=os.clock()+120
		repeat if fn() then return end;task.wait(.1) until os.clock()>deadline
		error("Tutorial test timed out")
	end
	local services=script.Parent.Services
	local Data=require(services.DataService)
	local Schema=require(script.Parent.Data.PlayerDataSchema)
	local Progress=require(services.TutorialProgress)
	local Tutorial=require(services.TutorialService)
	local Plots=require(services.PlotService)
	local Carry=require(services.CarryService)
	local Eggs=require(services.EggService)
	local Locks=require(services.FeedLocks)
	local Merchant=require(services.MerchantService)
	local Travel=require(services.TravelService)
	local MerchantConfig=require(game.ReplicatedStorage.Shared.Config.MerchantConfig)
	check(require(script.Parent.Data.DataStoreAdapter).IsMemory(),"Memory-only test profiles")
	local replies={}
	local report=Instance.new("RemoteEvent");report.Name="TutorialVerificationReport"
	report.OnServerEvent:Connect(function(player,key,result) replies[player.Name..key]=result end)
	report.Parent=game.ReplicatedStorage
	waitFor(function() return #game.Players:GetPlayers()==2 end)
	local a,b=table.unpack(game.Players:GetPlayers())
	waitFor(function() return Data.IsLoaded(a) and Data.IsLoaded(b) and Plots.GetPlot(a) and a.Character and a.Character:FindFirstChild("HumanoidRootPart") end)
	local data=Data.GetData(a)
	local root=a.Character.HumanoidRootPart
	root:SetNetworkOwner(nil)
	local function inspect(key)
		Tutorial.Refresh(a);report:FireClient(a,key)
		waitFor(function() return replies[a.Name..key]~=nil end)
		local reply=replies[a.Name..key]
		check(reply.Passed,"Client guide: "..key.." "..tostring(reply.Failure or ""))
	end
	check(data.Money==5000 and next(data.Inventory)==nil and data.Settings.TutorialStep=="BuyEgg","Fresh player starts with exactly 5000 and no test pet")
	local old=Schema.CreateDefault();old.Money=17;old.Settings={}
	local migrated=assert(Schema.Migrate(old))
	check(migrated.Money==17 and migrated.Settings.TutorialStep==nil,"Existing saves are not enrolled or granted Money")
	local probe=Schema.CreateDefault()
	Progress.Record(probe,"BoughtEgg","wrong","advanced_egg")
	check(probe.Settings.TutorialStep=="BuyEgg","Wrong egg cannot advance Basic Egg objective")
	Progress.Record(probe,"BoughtEgg","expected","prototype_egg")
	Progress.Record(probe,"Hatched","foreign","foreignPet")
	check(probe.Settings.TutorialStep=="PlaceEgg" and probe.Settings.TutorialPetId==nil,"Foreign hatch cannot replace tutorial identity")
	Progress.Record(probe,"Hatched","expected","expectedPet")
	Progress.Record(probe,"Fed","expectedPet")
	check(probe.Settings.TutorialStep=="PlacePet","Feed before buying food cannot complete tutorial")
	Progress.Record(probe,"BoughtFood",nil,"basic")
	Progress.Record(probe,"Fed","foreignPet")
	check(probe.Settings.TutorialStep=="PlacePet","Feeding another pet does not complete tracked objective")
	check(Data.Save(a) and Data.GetData(a).Money==5000,"Save does not repeat starting Money")
	root.CFrame=workspace.MysteryMerchant.InteractionPoint.CFrame+Vector3.new(0,3,0)
	local stockId=MerchantConfig.GetRestockId(os.time())
	check(Merchant.HandleRequest(a,"Purchase",1,stockId,1).Code=="TutorialBuyEgg" and data.Money==5000,"First egg budget cannot be spent on food")
	inspect("BuyEgg")
	local offer
	waitFor(function()
		local folder=workspace.PetConveyor:FindFirstChild("Offers")
		if folder then for _,model in folder:GetChildren() do if model:GetAttribute("EggId")=="prototype_egg" then offer=model;return true end end end
		return false
	end)
	root.CFrame=offer:GetPivot()+Vector3.new(0,3,0)
	local bought=require(services.ConveyorService).HandlePurchase(a,offer:GetAttribute("OfferId"))
	check(bought.Ok and data.Money==0 and data.Settings.TutorialStep=="PlaceEgg","Real conveyor purchase charges 5000 and advances tutorial")
	waitFor(function() return not Locks.IsLocked(a) end)
	check(data.Settings.TutorialEggUid==bought.EggUid,"Tutorial tracks exact egg identity")
	local saved=assert(Schema.Migrate(data))
	check(saved.Money==0 and saved.Settings.TutorialEggUid==bought.EggUid and saved.Settings.TutorialStep=="PlaceEgg","Interrupted tutorial round-trip preserves purchase without grant")
	assert(Carry.EquipEgg(a,bought.EggUid))
	inspect("PlaceEgg")
	local plot=Plots.GetPlot(a);local floor=plot.Pen.Floor
	local point=floor.Position+Vector3.new(0,floor.Size.Y/2,0)
	root.CFrame=CFrame.new(point+Vector3.new(0,3,0))
	check(Eggs.HandleRequest(a,"Place",bought.EggUid,point).Ok,"Tutorial egg uses normal placement")
	waitFor(function() return not Locks.IsLocked(a) end)
	Tutorial.Refresh(a)
	check(data.Settings.TutorialStep=="HatchEgg","Placed egg advances to hatch guidance")
	inspect("HatchEgg")
	waitFor(function() return os.time()>=data.IncubatingEggs[bought.EggUid].ReadyAt end)
	local hatch=Eggs.HandleRequest(a,"Hatch",bought.EggUid)
	check(hatch.Ok and data.Settings.TutorialPetId==hatch.PetId and data.Settings.TutorialStep=="PlacePet","Normal timed hatch advances with original pet identity")
	waitFor(function() return not Locks.IsLocked(a) end)
	assert(Carry.Equip(a,hatch.PetId))
	inspect("PlacePet")
	check(Carry.PlaceAt(a,hatch.PetId,point),"Place pet to earn through normal carry flow")
	data.Money=0;Progress.Reconcile(data)
	check(data.Settings.TutorialStep=="EarnMoney","Pet placement alone does not skip earning")
	data.Money=99
	check(require(services.MoneyService).Tick(a)>0,"Placed pet generates real income")
	Tutorial.Refresh(a)
	check(data.Money>=100 and data.Settings.TutorialStep=="MerchantTeleport","Money threshold uses at least 100, not exact equality")
	inspect("MerchantTeleport")
	check(Travel.HandleRequest(a,"Merchant").Ok and data.Settings.TutorialStep=="BuyFood","Successful Merchant teleport advances tutorial")
	inspect("BuyFood")
	stockId=MerchantConfig.GetRestockId(os.time())
	local purchase=Merchant.HandleRequest(a,"Purchase",1,stockId,1)
	check(purchase.Ok and purchase.Amount==5 and data.Food==5 and data.Settings.TutorialStep=="BaseTeleport","One Basic Food purchase advances; normal five-serving bundle unchanged")
	waitFor(function() return not Locks.IsLocked(a) end)
	inspect("BaseTeleport")
	task.wait(1)
	check(Travel.HandleRequest(a,"Base").Ok and data.Settings.TutorialStep=="Feed","Successful Base teleport advances to feed")
	inspect("PickupPet")
	local petModel=plot.Pen.ActivePets:FindFirstChild(hatch.PetId)
	local prompt=petModel:FindFirstChild("PickupPet",true)
	if not prompt then prompt=petModel:FindFirstChildWhichIsA("ProximityPrompt",true) end
	root.CFrame=petModel:GetPivot()+Vector3.new(0,2,0)
	check(Carry.BeginPickup(a,prompt),"Tutorial pet uses normal hold-E pickup")
	task.wait(require(game.ReplicatedStorage.Shared.Config.CarryConfig).PickupHoldSeconds)
	check(Carry.FinishPickup(a,prompt),"Completed hold picks up tutorial pet")
	inspect("PlaceOnPlate")
	root.CFrame=CFrame.new(plot.FeedPlate.Dish.Position+Vector3.new(0,3,0))
	check(Carry.PlaceOnPlate(a,hatch.PetId),"Tutorial uses normal feed plate placement")
	inspect("Feed")
	local fed=require(services.FeedService).HandleRequest(a,"Feed",hatch.PetId,1,"basic")
	check(fed.Accepted and data.Food==4 and data.Settings.TutorialStep=="Done","Real accepted Feed consumes food and completes tutorial")
	check(require(services.FeedService).HandleRequest(a,"Feed",hatch.PetId,1,"basic").Accepted and data.Food==4,"Feed replay cannot repeat food cost or tutorial reward")
	waitFor(function() return not Locks.IsLocked(a) end)
	inspect("Done")
	check(Data.Save(a),"Completed tutorial saves")
	local loaded=assert(Schema.Migrate(data))
	check(loaded.Settings.TutorialStep=="Done" and loaded.Money==data.Money,"Completion round-trip preserves balance; no grant replay")
	Progress.Record(loaded,"BoughtEgg","later","prototype_egg")
	check(loaded.Settings.TutorialStep=="Done" and loaded.Money==data.Money,"Completed tutorial cannot restart from later purchases")
	check(Data.GetData(b).Money==5000 and Data.GetData(b).Settings.TutorialStep=="BuyEgg","Other player's tutorial and balance stay independent")
	check(Schema.Validate(data),"Final tutorial profile validates")
end,debug.traceback)
testing:EndTest({passed=ok,checks=checks,failure=if ok then nil else tostring(failure)})
