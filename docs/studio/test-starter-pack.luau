local Offer = require("../../src/client/UI/StarterPackOffer")

local returning = Offer.new("Done")
returning:Observe(nil, 0)
returning:Observe("Done", 1)
assert(not returning:Take(20, false, false, true), "Do not popup for completed accounts on login")
local newPlayer = Offer.new("Done")
newPlayer:Observe("BuyEgg", 0)
assert(not newPlayer:Take(1, false, false, true))
newPlayer:Observe("Done", 2)
assert(not newPlayer:Take(2.5, false, false, true), "Allow replication to settle")
assert(not newPlayer:Take(9, nil, false, true), "Wait for ownership data")
assert(not newPlayer:Take(9, false, true, true), "Do not interrupt final feed")
assert(not newPlayer:Take(9, false, false, false), "Wait for living character")
assert(newPlayer:Take(9, false, false, true))
assert(not newPlayer:Take(10, false, false, true), "Only show once")
newPlayer:Observe("BuyEgg", 11)
newPlayer:Observe("Done", 12)
assert(not newPlayer:Take(15, false, false, true), "Dismissal must not repeat")
local owned = Offer.new("Done")
owned:Observe("Feed", 0); owned:Observe("Done", 1)
assert(not owned:Take(5, true, false, true) and owned.Consumed, "Skip existing buyers")
print("PASS: Starter pack eligibility, lock wait, late ownership, death and once-only gate")
